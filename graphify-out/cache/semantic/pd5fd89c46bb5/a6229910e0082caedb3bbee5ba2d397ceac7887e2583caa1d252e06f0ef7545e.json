{"nodes": [{"id": "docs_website_solutions_proposals", "label": "Website Solutions Proposals", "file_type": "document", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Translates the issues documented in Docs/website-issues.md into executable solutions; ordered execution preferred because some items depend on architecture and auth fixes first."}, {"id": "docs_website_solutions_build_fix", "label": "Fix Production Build", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_website_solutions_restaurant_creation", "label": "Restaurant Creation Page", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "createRestaurant server function verifies session, creates the restaurant with owner_id and an admin role atomically, redirects to /dashboard, and blocks authenticated users without a restaurant from preview fallback."}, {"id": "docs_website_solutions_password_reset", "label": "Password Reset Implementation", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Call sendPasswordResetEmail, show a generic message to avoid account enumeration, and validate reset-token expiry before saving a new password."}, {"id": "docs_website_solutions_real_server_functions", "label": "Real Server Functions", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared session/restaurant/role-ownership checks before every write; perform real Firebase operations server-side and return {data,error} or throw on failure so UI reflects true state."}, {"id": "docs_website_solutions_server_rate_limiting", "label": "Server-Side Rate Limiting", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keep the local limiter only as a UX optimization; counters move to shared storage keyed by email + network address/session; apply to login, signup, password reset, and role PIN."}, {"id": "docs_website_solutions_backend_decision", "label": "Backend Layer Decision", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Why: mixed Supabase naming over a Firebase adapter hides the real backend; decide Firebase-only or real Supabase, rename the compatibility layer to firebaseClient/typed repositories, and keep a temporary compat layer only during migration."}, {"id": "docs_website_solutions_adapter_redesign", "label": "Firebase Adapter Redesign", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replace the generic Proxy with small typed per-domain operations, implement or forbid like/ilike, fail loudly on unsupported operations, separate preview client from real Firebase client, and add query tests."}, {"id": "docs_website_solutions_oauth_realtime", "label": "OAuth and Realtime (Skipped)", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision: social login (Google/Apple) removed entirely, so the OAuth part is not implemented; scope limited to Realtime only if needed (Firestore onSnapshot or declared polling)."}, {"id": "docs_website_solutions_role_functions_completion", "label": "Complete Role Functions", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_website_solutions_reduce_any", "label": "Reduce any Usage", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Define typed entities (restaurant, order, employee, role, product, settings) and unified result types; replace any first in auth and sensitive layers; use unknown with narrowing at data boundaries."}, {"id": "docs_website_solutions_preview_separation", "label": "Separate Preview from Real Users", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mark preview mode explicitly (query param or documented demo session), allow mock data only with no real session, redirect authenticated no-restaurant users to /setup, and add a guard blocking mock writes from reaching production."}, {"id": "docs_website_solutions_i18n_completion", "label": "Complete i18n", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Either ship full resources for declared languages or remove fr/en from supportedLngs; move hardcoded JSX strings into i18n keys and test RTL, number/currency formatting, and navigation per language."}, {"id": "docs_website_solutions_oauth_callback_fix", "label": "OAuth Callback Fix (Obsolete)", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decision: after complete social-login removal there is no auth/callback route and no need for this solution."}, {"id": "docs_website_solutions_preview_token_security", "label": "Secure Preview Tokens", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mock_* tokens must be invalid outside local preview, never sent to the auth service, blocked by an environment check in production, and preview data kept in separate collections."}, {"id": "docs_website_solutions_no_fake_success", "label": "Prevent Fake Success Messages", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server functions return real results; no success toast until a confirmed save; show failure with retry; never return bot tokens in responses or store them in localStorage."}, {"id": "docs_website_solutions_implementation_phases", "label": "Five-Phase Implementation Plan", "file_type": "concept", "source_file": "Docs/website-solutions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Phases: (1) prevent deploy failure, (2) complete account cycle incl. removing social login, (3) bind functions to real data with permissions, (4) security/quality incl. server rate limiting and preview separation, (5) i18n and UX; plus a pre-launch checklist."}], "edges": [{"source": "docs_website_solutions_proposals", "target": "docs_website_issues_report", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "Docs/website-solutions.md", "source_location": null, "weight": 1.0}, {"source": "docs_website_solutions_oauth_realtime", "target": "docs_remove_social_login_prompt_prompt", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, 