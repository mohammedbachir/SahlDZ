# ─── SahlDZ environment variables ──────────────────────────────
# Copy to `.env.local` and fill in the real values.
# This file is pushed to GitHub as a reference; real keys stay in `.env.local`.

# ── Firebase (required for the full backend; omit to run preview mode) ──
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Web Push (FCM) VAPID key used for browser push notifications
VITE_FIREBASE_VAPID_KEY=your-vapid-public-key

# ── Firebase Emulator Suite (local development; 1 = use emulators) ──
VITE_USE_FIREBASE_EMULATORS=0
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Staff/restaurant token signing secret (server-side) ─────────
VITE_STAFF_TOKEN_SECRET=your-staff-token-secret

# ── App URL fallback (used when the browser origin is not available) ──
VITE_APP_URL=https://sahldz.vercel.app

# ── Server-only env (for hosted server builds; not exposed to the client) ──
NITRO_PRESET=vercel
BOT_USERNAME=sahldzDelivery_bot
# Token of the shared delivery bot (@sahldzDelivery_bot) — used to register
# delivery drivers and push new delivery orders to them. Get it from BotFather.
DELIVERY_BOT_TOKEN=

# ── Assistant AI (server-side) ──────────────────────────────────
SAHLDZ_AI_PROVIDER=gemini
SAHLDZ_AI_API_KEY=your-gemini-api-key
SAHLDZ_AI_MODEL=gemini-3.5-flash
# Optional comma-separated fallback models tried when the primary is unavailable
# (e.g. overloaded / 503). Built-in fallbacks: gemini-3.5-flash, gemini-3-flash-preview, gemini-flash-latest.
# SAHLDZ_AI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3-flash-preview

# ── GitHub image storage (optional, server-side) ─────────────────
# Images are uploaded to a PUBLIC GitHub repo and served via raw.githubusercontent.com.
# The token needs the `repo` (contents) scope and must be kept secret — never ship it to the client.
# Create a fine-grained / classic PAT at https://github.com/settings/tokens, then create a public repo.
GITHUB_IMG_TOKEN=your-github-personal-access-token
GITHUB_IMG_OWNER=your-github-username
GITHUB_IMG_REPO=sahldz-images
GITHUB_IMG_BRANCH=main

# ── Electron desktop (build only) ───────────────────────────────
VITE_DEV_SERVER_URL=http://localhost:8080